{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "checkers": ["typescript"],
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["/.pnpm-store", "/.verification", "/artifacts", "/coverage", "/dist"],
  "mutate": ["src/**/*.ts", "!src/main.ts", "!src/infrastructure/run-stdio-server.ts"],
  "plugins": ["@stryker-mutator/typescript-checker", "@stryker-mutator/vitest-runner"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "thresholds": {
    "break": 80,
    "high": 90,
    "low": 80
  },
  "timeoutMS": 5000
}
